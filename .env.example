# Optional. Without a key ProofPilot uses its offline rule-based planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: protect the HTTP API (clients send header X-API-Key)
PROOFPILOT_API_KEY=
# SQLite file for verified-result memory and LangGraph checkpoints
PROOFPILOT_DB=proofpilot.db
